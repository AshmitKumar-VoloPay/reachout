# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://localhost:5432/outreach_dev?sslmode=disable
ADDR=:8080

# Browser origins allowed to POST (comma separated). Vite dev server by default.
APP_ORIGINS=http://localhost:5173
# Set true when served over HTTPS
COOKIE_SECURE=false

# Linked API (admin token is product-level; keep server-side only). Required.
LINKED_API_TOKEN=
# Leave empty for the public API (https://api.linkedapi.io)
LINKED_API_BASE_URL=
# Signing secret of the Linked API webhook (shown when you register it, with signing on).
# The webhook URL to register is https://<your-host>/webhooks/linkedapi. Without this secret
# the endpoint refuses every event and replies and accepted requests are not noticed.
LINKED_API_WEBHOOK_SECRET=

# Required. 32 random bytes, base64: openssl rand -base64 32
# Encrypts identification tokens at rest. Losing it means accounts must be reconnected.
TOKEN_ENCRYPTION_KEY=

# Set to false to stop all outbound sending
WORKER_ENABLED=true
