# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://localhost:5432/outreach_dev?sslmode=disable
ADDR=:8080

# Linked API (admin token is product-level; keep server-side only)
LINKED_API_TOKEN=
LINKED_API_WEBHOOK_SECRET=

# 32 random bytes, base64. Used to encrypt identification tokens at rest.
TOKEN_ENCRYPTION_KEY=

# Set to false to stop all outbound sending
WORKER_ENABLED=true
